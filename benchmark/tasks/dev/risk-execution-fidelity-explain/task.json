    {
      "id": "strict-exclusions",
      "type": "numeric",
      "weight": "blocking",
      "artifact_id": "strict_run",
      "pointer": "/diagnostics/execution_data_exclusions/symbol_date_count",
      "expect": 50,
      "tolerance": 0
    },
    {
      "id": "both-unreliable",
      "type": "judged",
      "weight": "scored",
      "rubric": "The answer states that execution_reliable is false under BOTH policies, for different reasons: ILLUSTRATIVE_EXECUTION_DATA under illustrative, MISSING_EXECUTION_STATE under strict. Presenting the illustrative run as the reliable one fails."
    },
    {
      "id": "names-root-cause",
      "type": "judged",
      "weight": "scored",
      "rubric": "The answer identifies the shared root cause: the bundle has no suspension or price-limit coverage. Illustrative proceeds without that coverage and warns; strict refuses to fill without it. The difference is data availability, not a difference in the strategy or the risk model."
    },
    {
      "id": "fidelity-interpreted",
      "type": "judged",
      "weight": "scored",
      "rubric": "The answer interprets execution_fidelity correctly: 0.9996 under illustrative means realized weights tracked targets almost exactly, 0.0 under strict with a maximum target-weight deviation of 1.0 means no target was reached at all. Reading the strict 0.0 as perfect or as low tracking error fails."
    },
    {
      "id": "no-policy-recommendation-without-data",
      "type": "judged",
      "weight": "scored",
      "rubric": "The answer does not recommend simply switching to illustrative to make the numbers look workable. The correct recommendation is to obtain suspension and price-limit coverage, using illustrative only as an explicitly caveated stand-in."
    }
  ],
  "negative_case": null,
  "notes": "Requires two authorized runs over the same window. The user authorizes both explicitly in the prompt.",
  "tags": ["execution-policy", "execution-fidelity", "risk", "demo-bundle"]
