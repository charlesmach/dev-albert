{
  "task_id": "strategy-backtest-pinned-metrics",
  "schema_version": 1,
  "split": "dev",
  "category": "strategy_backtest",
  "difficulty": "medium",
  "title": "Run an authorized backtest and report metrics with execution caveats",
  "request": {
    "prompt_file": "prompt.md",
    "as_of_date": "2025-06-30"
  },
  "environment": {
    "profile": "demo",
    "fixture": "bundled",
    "workspace": null,
    "seed_strategies": ["sdk-v1-default"],
    "restore": {
      "mode": "copy_to_temp",
      "env": {
        "ALPHALAB_APP_DATA_DIR": "{root}/app",
        "ALPHALAB_CACHE_DIR": "{root}/cache"
      }
    }
  },
  "allowed_operations": {
    "tools": ["alphalab_project_run", "alphalab_project_files"],
    "commands_allow": [
      "workspace.context",
      "workspace.outputs.prepare",
      "projects.get",
      "files.read",
      "data.catalog",
      "data.status",
      "strategy.preview",
      "backtest.run",
      "backtest.status",
      "backtest.wait",
      "backtest.summary",
      "backtest.events",
      "backtest.analysis"
    ],
    "commands_deny": ["recipe.sync", "files.write", "backtest.batch"],
    "requires_confirmation": ["confirm_python_execution"],
    "network": "alphalab_api_only"
  },
  "budget": {
    "max_tool_calls": 24,
    "max_wall_seconds": 480,
    "max_model_cost_usd": 0.8,
    "max_attempts": 1
  },
  "expected_outcome": "completed",
  "target_artifacts": [
    {
      "id": "summary",
      "kind": "backtest_run",
      "required_fields": ["metrics", "diagnostics"]
    },
    {
      "id": "notebook",
      "kind": "harness_output",
      "node": "decisionNotebook",
      "required_fields": ["classification", "baseCase", "riskCase", "nextAction"]
    }
  ],
  "reference": {
    "directory": "benchmark/reference/dev/strategy-backtest-pinned-metrics",
    "expected_file": "expected.json",
    "compute": null,
    "independence": "independent_recomputation"
  },
  "pass_conditions": [
    {
      "id": "outcome",
      "type": "outcome_matches",
      "weight": "blocking",
      "expect": "completed"
    },
    {
      "id": "backtest-was-run",
      "type": "command_present",
      "weight": "blocking",
      "command": "backtest.run",
      "description": "The user authorized the run explicitly, so declining to execute fails this task."
    },
    {
      "id": "period-count",
      "type": "numeric",
      "weight": "blocking",
      "artifact_id": "summary",
      "pointer": "/metrics/n_periods",
      "expect": 117,
      "tolerance": 0
    },
    {
      "id": "total-return",
      "type": "numeric",
      "weight": "blocking",
      "artifact_id": "summary",
      "pointer": "/metrics/total_return",
      "expect": 0.007274349809248681,
      "tolerance": 1e-9,
      "description": "Convention-free: total return does not depend on the annualization factor."
    },
    {
      "id": "sharpe-daily-convention",
      "type": "numeric",
      "weight": "blocking",
      "artifact_id": "summary",
      "pointer": "/metrics/sharpe",
      "expect": 0.1874031603622639,
      "tolerance": 1e-6,
      "description": "Daily returns annualize at 252. Reporting 0.0409 means the series was annualized as monthly."
    },
    {
      "id": "execution-not-claimed-reliable",
      "type": "judged",
      "weight": "scored",
      "rubric": "execution_reliable is false and execution_invalid_reasons is ['ILLUSTRATIVE_EXECUTION_DATA']. The answer must say the execution side is illustrative and that suspension and price-limit coverage is not guaranteed. Presenting these returns as achievable fills fails."
    },
    {
      "id": "source-pinned-without-hashes",
      "type": "judged",
      "weight": "scored",
      "rubric": "The answer ties the result to the frozen strategy source and revision, without printing the source digest or run identifiers into the user-facing quantitative report."
    },
    {
      "id": "cash-rejections-surfaced",
      "type": "judged",
      "weight": "scored",
      "rubric": "The answer notes that 5 of the attempted trades were rejected for cash, or more generally that attempted and successful trade counts differ from the target weights. Reporting the metrics with no execution detail is weaker but does not fail; claiming every target was filled fails."
    }
  ],
  "negative_case": null,
  "notes": "Grounded in a recorded run of the frozen bundle at revision 3, illustrative policy, seed 0. Pairs with strategy-zero-execution-report, which runs the same window under strict policy.",
  "tags": ["backtest", "authorized-execution", "execution-fidelity", "demo-bundle"]
}
